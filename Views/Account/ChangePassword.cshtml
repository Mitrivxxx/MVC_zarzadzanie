@model MyMvcPostgresApp.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Zmień hasło";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <i class="bi bi-shield-lock fs-1 text-primary"></i>
                    <h3 class="mt-2 mb-0">Zmień hasło</h3>
                    <small class="text-muted">Zadbaj o bezpieczeństwo swojego konta</small>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="ChangePassword" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold">Aktualne hasło</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword(this, '#CurrentPassword')">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">Nowe hasło</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" oninput="updateStrength(this.value)" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword(this, '#NewPassword')">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div id="pwBar" class="progress-bar bg-danger" role="progressbar" style="width: 0%" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small id="pwHint" class="text-muted d-block mt-1">Min. 8 znaków, litery i cyfry, najlepiej również znak specjalny.</small>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Potwierdź nowe hasło</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword(this, '#ConfirmNewPassword')">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg" type="submit">
                            <i class="bi bi-check2-circle me-1"></i>Zapisz
                        </button>
                        <a asp-action="Details" class="btn btn-outline-secondary">
                            Anuluj
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePassword(btn, selector) {
            const input = document.querySelector(selector);
            const icon = btn.querySelector('i');
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        function updateStrength(value) {
            const bar = document.getElementById('pwBar');
            const hint = document.getElementById('pwHint');
            if (!bar) return;

            let score = 0;
            if (value.length >= 8) score += 25;
            if (/[A-Z]/.test(value)) score += 25;
            if (/[0-9]/.test(value)) score += 25;
            if (/[^A-Za-z0-9]/.test(value)) score += 25;

            bar.style.width = score + '%';

            if (score < 50) {
                bar.className = 'progress-bar bg-danger';
                hint.textContent = 'Słabe hasło — dodaj wielkie litery, cyfry i znaki specjalne.';
            } else if (score < 75) {
                bar.className = 'progress-bar bg-warning';
                hint.textContent = 'Średnie hasło — dodaj jeszcze znak specjalny lub wydłuż hasło.';
            } else {
                bar.className = 'progress-bar bg-success';
                hint.textContent = 'Dobre hasło.';
            }
        }
    </script>
}