<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PM Suite</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyMvcPostgresApp.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark header-gradient shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" class="app-logo" alt="PM Suite logo" />
                    <span class="fw-semibold">PM Suite</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock me-1"></i>Privacy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">
                                <i class="bi bi-envelope me-1"></i>Kontakt
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                        <li class="nav-item me-lg-2">
                            <a class="nav-link" asp-controller="MyProjects" asp-action="Index">
                                <i class="bi bi-folder-fill me-1"></i>Moje Projekty
                            </a>
                        </li>

                        <li class="nav-item me-lg-2">
                            <a class="nav-link" asp-controller="Tasks" asp-action="MyTasks">
                                <i class="bi bi-check2-square me-1"></i>Moje Zadania
                            </a>
                        </li>

                        <li class="nav-item me-lg-2">
                            <a class="nav-link position-relative" asp-controller="Notifications" asp-action="Index"
                                id="notificationLink">
                                <i class="bi bi-bell-fill"></i>
                                <span
                                    class="badge rounded-pill bg-warning text-dark position-absolute top-0 start-100 translate-middle d-none"
                                    id="notificationBadge">0</span>
                            </a>
                        </li>

                        @if (role == "Admin")
                        {
                        <li class="nav-item dropdown me-lg-2">
                            <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear-fill me-1"></i>Zarządzaj
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                        <i class="bi bi-people-fill me-2"></i>Użytkownicy
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Projects" asp-action="Index">
                                        <i class="bi bi-kanban-fill me-2"></i>Projekty
                                    </a>
                                </li>
                            </ul>
                        </li>
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown"
                                role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span>@User.Identity!.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Details">Konto</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-1"></i>Wyloguj
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        }
                        else
                        {
                        <li class="nav-item me-lg-2">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Zaloguj
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm ms-lg-1" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Zarejestruj
                            </a>
                        </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="py-4 border-top mt-5">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <strong>PM Suite</strong>
                <div><small>© 2025 PM Suite. All rights reserved.</small></div>
            </div>
            <div class="text-end">
                <small class="d-block">Contact: hello@pmsuite.example</small>
                <small>Privacy policy</small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
    <script>
        async function updateNotificationBadge() {
            try {
                const response = await fetch('/Notifications/GetUnreadCount');
                const data = await response.json();
                const badge = document.getElementById('notificationBadge');
                if (!badge) return;
                if (data.count > 0) {
                    badge.textContent = data.count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            } catch { /* ignore */ }
        }
        document.addEventListener('DOMContentLoaded', updateNotificationBadge);
        setInterval(updateNotificationBadge, 30000);
    </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>